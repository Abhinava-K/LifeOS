# ==============================================================================
# LifeOS Platform — Production Environment Configuration (.env.production)
# IEEE 830 Architecture Baseline (Phases 1–6 Complete)
# ==============================================================================

# Server Network & Runtime
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Security & Dual-Token JWT Engine (REQ-AUTH)
JWT_SECRET=super_secret_production_entropy_key_change_in_cloud_vault_2026
JWT_ACCESS_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=604800s
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Relational Storage & pgvector (PostgreSQL 15)
DATABASE_URL=postgresql://lifeos_admin:lifeos_secure_pass_2026@localhost:5432/lifeos_db?schema=public

# In-Memory Cache & Background BullMQ (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Multi-LLM AI Router Gateway (REQ-AIGW, REQ-MEM)
GEMINI_API_KEY=your_gemini_pro_api_key_here
GROQ_API_KEY=your_groq_llama3_api_key_here
CREWAI_MICROSERVICE_URL=http://localhost:8000/api/v1/dispatch

# Third-Party Google Workspace Integration (REQ-GGL)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/google/callback

# Storage Limits & Vault Quota (REQ-DOC)
MAX_DOCUMENT_UPLOAD_SIZE_BYTES=26214400 # 25MB boundary
